{
  "name": "demonstrator",
  "version": "1.3.0",
  "private": true,
  "description": "An Angular demo workspace for actions, announcements, dashboards, and settings.",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm audit --audit-level=high && npm run lint && npm run format:check && npm test -- --watch=false --browsers=ChromeHeadless && npm run build",
    "deploy": "ng deploy",
    "release": "node src/scripts/release.js"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,js,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitinjangra/demonstrator.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/nitinjangra/demonstrator/issues"
  },
  "homepage": "https://github.com/nitinjangra/demonstrator#readme",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "ag-grid-angular": "^36.0.1",
    "chart.js": "^4.6.1",
    "highcharts": "^13.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^9.0.0",
    "@types/jasmine": "^6.0.0",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "^22.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jasmine-core": "^4.6.1",
    "jsdom": "^28.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
